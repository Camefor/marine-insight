@page "/account/access-denied"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>无权访问 - Marine Insight</PageTitle>

<main class="account-page">
    <section class="account-panel" aria-labelledby="access-denied-title">
        <p class="account-eyebrow">Marine Insight</p>
        <h1 id="access-denied-title">无权访问</h1>
        <p class="account-alert" role="alert">当前账户没有访问该资源的权限。</p>
        <a class="account-submit account-submit-link" href="/">返回 Dashboard</a>
    </section>
</main>
