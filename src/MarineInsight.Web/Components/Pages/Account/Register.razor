@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]
@using MarineInsight.Web.Authentication
@inject CaptchaService Captcha
<PageTitle>注册 | Marine AI</PageTitle>

<main class="account-page">
    <section class="account-panel" aria-labelledby="register-title">
        <p class="account-eyebrow">Marine AI</p>
        <h1 id="register-title">创建账户</h1>

        @if (ErrorCode == "password")
        {
            <p class="account-alert" role="alert">密码需至少 10 位，并包含大小写字母、数字和符号。</p>
        }
        else if (ErrorCode == "confirm")
        {
            <p class="account-alert" role="alert">两次输入的密码不一致。</p>
        }
        else if (ErrorCode == "captcha")
        {
            <p class="account-alert" role="alert">验证码不正确或已过期，请重试。</p>
        }
        else if (ErrorCode == "email-exists")
        {
            <p class="account-alert" role="alert">该邮箱已注册，请直接<a href="/account/login">登录</a>。</p>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorCode))
        {
            <p class="account-alert" role="alert">暂时无法创建账户，请检查输入或稍后重试。</p>
        }

        <form class="account-form" method="post" action="/account/register">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <label>
                <span>邮箱</span>
                <input name="Email" type="email" autocomplete="username" required maxlength="256" />
            </label>
            <label>
                <span>密码</span>
                <input name="Password" type="password" autocomplete="new-password" required minlength="10" maxlength="128" />
            </label>
            <label>
                <span>确认密码</span>
                <input name="ConfirmPassword" type="password" autocomplete="new-password" required minlength="10" maxlength="128" />
            </label>
            @if (Captcha.Enabled)
            {
                <input type="hidden" name="CaptchaId" value="@(_challenge?.Id)" />
                <label class="account-captcha-field">
                    <span>验证码</span>
                    <div class="account-captcha">
                        <span class="account-captcha-svg">@((MarkupString)(_challenge?.Svg ?? string.Empty))</span>
                        <input class="account-captcha-input" name="CaptchaCode" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" required maxlength="4" placeholder="4 位验证码" />
                        <a class="account-captcha-refresh" href="/account/register">换一张</a>
                    </div>
                </label>
            }
            <button class="account-submit" type="submit">注册</button>
        </form>

        <p class="account-switch">已有账户？<a href="/account/login">登录</a></p>
    </section>
</main>

@code {
    private CaptchaChallenge? _challenge;

    [SupplyParameterFromQuery(Name = "error")]
    [Parameter]
    public string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (Captcha.Enabled)
        {
            _challenge = Captcha.Generate();
        }
    }
}
