@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using MarineInsight.Application.Locations
@using MarineInsight.Domain.Forecast
@using Microsoft.Extensions.Configuration
@inject DashboardQuerySession Session
@inject IJSRuntime Js
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserWorkspaceService Workspace
@inject ReverseGeocodeService ReverseGeocode
@inject IConfiguration Configuration
@implements IAsyncDisposable


<PageTitle>Marine AI | 海岛海况智能决策平台</PageTitle>
<HeadContent>
    <link rel="canonical" href="https://marine.loyalme.life/" />
</HeadContent>

<main class="dashboard-shell">
    <section class="dashboard-header" aria-labelledby="dashboard-title">
        <div>
            <p class="eyebrow">Marine AI</p>
            <h1 id="dashboard-title">海岛海况智能决策平台</h1>
            <p class="dashboard-slogan">为海钓、露营、摄影和航海而生。</p>
            <p class="dashboard-subtitle">选择预置地点和时间范围，查看逐小时评分、活动建议、主要风险、来源与数据质量。</p>
        </div>
        <div class="disclaimer" role="note">
            结果仅供辅助决策，请以官方预警和现场管理为准。
        </div>
    </section>

    <section class="query-band" aria-labelledby="query-title">
        <h2 id="query-title">查询</h2>
        <form class="query-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <div class="location-controls">
                <label class="field">
                    <span>地点搜索</span>
                    <input type="search"
                           autocomplete="off"
                           placeholder="输入海岛或码头名称"
                           @bind="Session.SearchText" />
                </label>
                <button class="secondary-button" type="button" @onclick="SearchLocationsAsync" disabled="@Session.IsSearching">
                    @(Session.IsSearching ? "搜索中" : "查找地点")
                </button>
                <button class="secondary-button" type="button" @onclick="ToggleMapPickerAsync">
                    @(Session.IsMapPickerOpen ? "收起地图" : "地图选点")
                </button>
            </div>

            @if (HasSelection)
            {
                <div class="selected-location-bar">
                    <span class="selected-location-name">
                        <strong>@SelectedDisplayName</strong>
                        <em>@SelectedCoordinate</em>
                    </span>
                </div>
            }

            @if (Session.LocationResults.Count > 0)
            {
                <div class="candidate-list" aria-label="地点候选">
                    @foreach (var location in Session.LocationResults)
                    {
                        <button type="button"
                                class="candidate-button @(Session.SelectedLocation?.Id == location.Id ? "selected" : null)"
                                title="@($"{location.DisplayName} {location.Latitude:0.###}, {location.Longitude:0.###}")"
                                @onclick="() => SelectLocationAsync(location.Id)">
                            <strong>@location.DisplayName</strong>
                            <span>@location.LocationType · @location.TimeZone · @location.Latitude.ToString("0.###")/@location.Longitude.ToString("0.###")</span>
                        </button>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Session.SearchError))
            {
                <p class="inline-error" role="status">@Session.SearchError</p>
            }

            @if (Session.IsMapPickerOpen)
            {
                <div class="map-picker" aria-labelledby="map-picker-title">
                    <div class="map-picker-heading">
                        <div>
                            <h3 id="map-picker-title">地图选点</h3>
                            <p>点击地图或输入经纬度，坐标会进入同一海况查询流程。</p>
                        </div>
                        <p class="map-attribution">
                            地图数据 © <a href="https://www.tianditu.gov.cn" target="_blank" rel="noopener noreferrer">天地图</a>
                        </p>
                    </div>

                    <div id="dashboard-map-picker"
                         class="map-canvas"
                         role="application"
                         aria-label="天地图地图选点"></div>

                    @if (Session.IsMapUnavailable || !string.IsNullOrWhiteSpace(Session.MapError))
                    {
                        <p class="inline-error" role="status">@Session.MapError</p>
                    }

                    <div class="coordinate-fallback" aria-label="坐标输入降级">
                        <label class="field">
                            <span>纬度</span>
                            <input type="number"
                                   step="0.000001"
                                   min="-90"
                                   max="90"
                                   @bind="Session.MapLatitude" />
                        </label>
                        <label class="field">
                            <span>经度</span>
                            <input type="number"
                                   step="0.000001"
                                   min="-180"
                                   max="180"
                                   @bind="Session.MapLongitude" />
                        </label>
                        <button class="secondary-button" type="button" @onclick="UseManualCoordinatesAsync">
                            使用坐标
                        </button>
                        <span class="selected-coordinate">
                            @if (Session.SelectedMapPoint is not null)
                            {
                                @($"当前坐标 {Session.SelectedMapPoint.Latitude:0.######}, {Session.SelectedMapPoint.Longitude:0.######}")
                            }
                            else if (Session.SelectedLocation is not null)
                            {
                                @($"当前地点 {Session.SelectedLocation.DisplayName} · {Session.SelectedLocation.Latitude:0.###}, {Session.SelectedLocation.Longitude:0.###}")
                            }
                            else
                            {
                                @("尚未选择坐标")
                            }
                        </span>
                    </div>

                    <label class="field map-point-name">
                        <span>地点名称（可选）</span>
                        <input type="text"
                               maxlength="200"
                               placeholder="地图选点后自动填充，留空显示“自定义坐标”"
                               @bind="Session.MapPointName" />
                    </label>
                    <p class="map-point-hint">该名称仅作为地点备注，收藏地点时将按此名称显示。</p>
                </div>
            }

            <div class="range-controls">
                <label class="field datetime-field">
                    <span class="datetime-label">
                        <span>起报时间</span>
                        <small>@Session.DisplayTimeZoneLabel</small>
                    </span>
                    <span class="datetime-control datetime-parts" lang="zh-CN">
                        <span class="forecast-date-picker-shell" lang="zh-CN" role="group" aria-label="起报日期" aria-describedby="forecast-time-hint">
                            <DatePicker TValue="DateTime?"
                                        ClassName="forecast-date-picker"
                                        DropdownClassName="forecast-date-dropdown"
                                        Value="@Session.ForecastStartLocal"
                                        OnChange="OnForecastDateChanged"
                                        Format="yyyy-MM-dd"
                                        CultureInfo="@ChineseCulture"
                                        InputReadOnly="true"
                                        AllowClear="false"
                                        lang="zh-CN" />
                        </span>
                        <span class="forecast-time-picker-shell" role="group" aria-label="起报小时" aria-describedby="forecast-time-hint">
                            <TimePicker TValue="TimeOnly?"
                                        ClassName="forecast-time-picker"
                                        DropdownClassName="forecast-time-dropdown"
                                        Value="@TimeOnly.FromDateTime(Session.ForecastStartLocal)"
                                        OnChange="OnForecastTimeChanged"
                                        Format="HH:00"
                                        CultureInfo="@ChineseCulture"
                                        InputReadOnly="true"
                                        AllowClear="false" />
                        </span>
                    </span>
                    <small id="forecast-time-hint" class="datetime-hint">@Session.ForecastStartHint</small>
                </label>

                <fieldset class="segmented-group">
                    <legend>范围</legend>
                    @foreach (var hours in HourOptions)
                    {
                        <button type="button"
                                class="segment @(Session.Hours == hours ? "active" : null)"
                                @onclick="() => Session.Hours = hours">
                            @(hours == 168 ? "7d" : $"{hours}h")
                        </button>
                    }
                </fieldset>

                <AuthorizeView>
                    <Authorized>
                        <label class="paid-provider-option">
                            <input type="checkbox" @bind="Session.IncludeTide" disabled="@Session.IsLoadingAnalysis" />
                            <span>
                                <strong>查询潮汐</strong>
                                <small>按需调用 WorldTides，会消耗 Credits</small>
                            </span>
                        </label>
                    </Authorized>
                    <NotAuthorized>
                        <a class="paid-provider-option locked" href="/account/login?returnUrl=%2F">
                            <UiIcon Name="LockKeyhole" />
                            <span>
                                <strong>登录后可查询潮汐</strong>
                                <small>潮汐为付费 API 数据，默认不查询</small>
                            </span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

                <button class="primary-button" type="submit" disabled="@(!Session.CanSubmit)">
                    @(Session.IsLoadingAnalysis ? "查询中" : "查询海况")
                </button>
            </div>
        </form>

        @if (Session.IsLoadingAnalysis)
        {
            <div class="query-loading" role="status" aria-live="polite" aria-atomic="true">
                <span class="spinner" aria-hidden="true"></span>
                <span class="query-loading-copy">
                    <strong>正在查询海况</strong>
                    <span>@(Session.IncludeTide ? "正在汇总天气、海浪与潮汐数据，完成后将在下方更新结果。" : "正在汇总天气与海浪数据，完成后将在下方更新结果。")</span>
                </span>
                <span class="query-loading-badge" aria-hidden="true">数据汇总中</span>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Session.AnalysisError))
    {
        <section class="status-band error" role="alert">
            <strong>查询失败</strong>
            <span>@Session.AnalysisError</span>
            <button type="button" class="secondary-button" @onclick="SubmitAsync" disabled="@(!Session.CanSubmit)">重试</button>
        </section>
    }

    @if (Session.Result is null)
    {
        <section class="empty-state">
            <h2>等待查询</h2>
            <p>先搜索并选择一个预置地点，或通过地图/坐标选择位置，再提交 24h、72h 或 7d 查询。</p>
        </section>
    }
    else
    {
        var result = Session.Result;
        <section class="summary-band" aria-labelledby="summary-title">
            <div>
                <h2 id="summary-title">@result.DisplayName</h2>
                <p>@result.Latitude.ToString("0.###"), @result.Longitude.ToString("0.###") · 显示时区 @Session.DisplayTimeZoneLabel</p>
            </div>
            <dl class="summary-grid">
                <div>
                    <dt>范围</dt>
                    <dd>@result.Hours 小时</dd>
                </div>
                <div>
                    <dt>综合分</dt>
                    <dd>@(result.Overall?.Score ?? "暂无") · @(result.Overall?.RiskLevelText ?? "数据不足")</dd>
                </div>
                <div>
                    <dt>置信度</dt>
                    <dd>@(result.Overall?.Confidence ?? "暂无")</dd>
                </div>
                <div>
                    <dt>算法</dt>
                    <dd>@(result.Overall?.AlgorithmVersion ?? "暂无")</dd>
                </div>
                <div>
                    <dt>质量</dt>
                    <dd>@result.QualityStatus / @result.Freshness</dd>
                </div>
                <div>
                    <dt>完整度</dt>
                    <dd>@result.Completeness.ToString("P0")</dd>
                </div>
                <div class="summary-span">
                    <dt>时间</dt>
                    <dd>@Session.FormatDisplay(result.FromUtc) - @Session.FormatDisplay(result.ToUtc)</dd>
                </div>
            </dl>

            @if (HasSelection)
            {
                <div class="favorite-controls">
                    <AuthorizeView>
                        <Authorized>
                            <button class="favorite-button @(_isFavorited ? "active" : null)" type="button"
                                    aria-pressed="@_isFavorited"
                                    title="@(_isFavorited ? "取消收藏" : "收藏当前地点")"
                                    @onclick="ToggleFavoriteAsync">
                                <UiIcon Name="Star" CssClass="favorite-star" />
                                <span>@(_isFavorited ? "已收藏" : "收藏")</span>
                            </button>
                            @if (!string.IsNullOrWhiteSpace(_workspaceStatus))
                            {
                                <span class="workspace-inline-status" role="status">@_workspaceStatus</span>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a class="favorite-button" href="/account/login?returnUrl=/">
                                <UiIcon Name="Star" CssClass="favorite-star" />
                                <span>登录后收藏</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            }
        </section>

        <section class="explanation-section" aria-labelledby="explanation-title">
            <div class="section-heading">
                <h2 id="explanation-title">智能解读</h2>
                @if (result.Explanation.Degraded)
                {
                    <span class="explanation-badge degraded">智能解读已降级</span>
                }
                else if (result.Explanation.Source == "ai")
                {
                    <span class="explanation-badge ai">AI 生成</span>
                }
            </div>
            <p class="explanation-headline">@result.Explanation.Headline</p>
            <p class="explanation-summary">@result.Explanation.Summary</p>
            @if (result.Explanation.ActivityNotes.Count > 0)
            {
                <ul class="explanation-notes">
                    @foreach (var note in result.Explanation.ActivityNotes)
                    {
                        <li><strong>@note.Label</strong>：@note.Text</li>
                    }
                </ul>
            }
            @if (!string.IsNullOrWhiteSpace(result.Explanation.RiskWindowText))
            {
                <p class="explanation-risk">@result.Explanation.RiskWindowText</p>
            }
            @if (!string.IsNullOrWhiteSpace(result.Explanation.UncertaintyText))
            {
                <p class="explanation-uncertainty">@result.Explanation.UncertaintyText</p>
            }
        </section>

        @if (result.ActivityScores.Count > 0)
        {
            <section class="activity-section" aria-labelledby="activity-title">
                <h2 id="activity-title">活动评分</h2>
                <div class="activity-list">
                    @foreach (var activity in result.ActivityScores)
                    {
                        <article class="activity-item risk-@activity.RiskLevel">
                            <span>@activity.Label</span>
                            <strong>@activity.Score</strong>
                            <em>@activity.RiskLevelText</em>
                        </article>
                    }
                </div>
            </section>
        }

        @if (result.TopRisks.Count > 0)
        {
            <section class="risk-section" aria-labelledby="risk-title">
                <h2 id="risk-title">主要风险</h2>
                <div class="risk-list">
                    @foreach (var risk in result.TopRisks)
                    {
                        <article class="risk-item severity-@risk.Severity">
                            <strong>@risk.Code</strong>
                            <span>@risk.Message</span>
                            <em>扣分 @risk.Penalty</em>
                        </article>
                    }
                </div>
            </section>
        }

        @if (result.TrendTabs.Count > 0)
        {
            var selectedTrend = result.TrendTabs.FirstOrDefault(tab => tab.Key == Session.SelectedTrendKey) ?? result.TrendTabs[0];
            var selectedDetail = Session.SelectedHourlyDetail;

            <section class="trend-section" aria-labelledby="trend-title">
                <div class="section-heading">
                    <h2 id="trend-title">逐小时趋势</h2>
                    <div class="trend-tabs" role="tablist" aria-label="趋势视图">
                        @foreach (var tab in result.TrendTabs)
                        {
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(selectedTrend.Key == tab.Key)"
                                    class="trend-tab @(selectedTrend.Key == tab.Key ? "active" : null)"
                                    @onclick="() => Session.SelectTrend(tab.Key)">
                                @tab.Label
                            </button>
                        }
                    </div>
                </div>

                <div class="trend-layout">
                    <div class="trend-panel">
                        <div class="trend-scale" aria-hidden="true">
                            <span>@selectedTrend.PrimaryLabel</span>
                            <span>@selectedTrend.SecondaryLabel</span>
                        </div>
                        <div class="trend-points" role="list" aria-label="@($"{selectedTrend.Label}趋势")">
                            @foreach (var point in selectedTrend.Points)
                            {
                                <button type="button"
                                        role="listitem"
                                        class="trend-point risk-@point.RiskLevel @(Session.SelectedHourlyDetail?.ForecastTimeUtc == point.ForecastTimeUtc ? "selected" : null) @(point.IsRecommended ? "recommended" : null)"
                                        style="@($"--primary:{point.PrimaryPercent}%;--secondary:{point.SecondaryPercent}%;")"
                                        title="@($"{Session.FormatDisplay(point.ForecastTimeUtc)} {selectedTrend.PrimaryLabel} {point.PrimaryValue} {selectedTrend.SecondaryLabel} {point.SecondaryValue}")"
                                        @onclick="() => Session.SelectHour(point.ForecastTimeUtc)">
                                    <span class="trend-time">@Session.FormatDisplayTime(point.ForecastTimeUtc)</span>
                                    <span class="trend-bars" aria-hidden="true">
                                        <span class="trend-bar primary"></span>
                                        <span class="trend-bar secondary"></span>
                                    </span>
                                    <span class="trend-values">
                                        <strong>@point.PrimaryValue</strong>
                                        <em>@point.SecondaryValue</em>
                                    </span>
                                    @if (point.IsRiskRise)
                                    {
                                        <span class="trend-marker">风险</span>
                                    }
                                    else if (point.IsReturnBefore)
                                    {
                                        <span class="trend-marker return">返航</span>
                                    }
                                </button>
                            }
                        </div>

                        @if (result.TimelineWindows.Count > 0)
                        {
                            <div class="timeline-band" aria-label="推荐窗口时间带">
                                @foreach (var window in result.TimelineWindows)
                                {
                                    <span class="timeline-window"
                                          style="@($"left:{window.StartPercent}%;width:{window.WidthPercent}%;")"
                                          title="@($"{window.Label} {Session.FormatDisplay(window.StartUtc)} - {Session.FormatDisplay(window.EndUtc)}")">
                                        @window.Label
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @if (selectedDetail is not null)
                    {
                        <aside class="hour-detail-panel" aria-labelledby="hour-detail-title">
                            <div class="hour-detail-header">
                                <div>
                                    <h3 id="hour-detail-title">@Session.FormatDisplay(selectedDetail.ForecastTimeUtc)</h3>
                                    <p>@selectedDetail.Score · @selectedDetail.RiskLevelText · @selectedDetail.QualityStatus / @selectedDetail.Freshness</p>
                                </div>
                            </div>

                            <dl class="detail-metric-grid">
                                @foreach (var metric in selectedDetail.Metrics)
                                {
                                    <div>
                                        <dt>@metric.Label</dt>
                                        <dd>@metric.Value <span>@metric.Unit</span></dd>
                                    </div>
                                }
                            </dl>

                            @if (selectedDetail.Risks.Count > 0)
                            {
                                <div class="detail-block">
                                    <strong>风险贡献</strong>
                                    @foreach (var risk in selectedDetail.Risks)
                                    {
                                        <p>@risk.Code：@risk.Message</p>
                                    }
                                </div>
                            }

                            @if (selectedDetail.Sources.Count > 0)
                            {
                                <div class="detail-block">
                                    <strong>指标来源</strong>
                                    @foreach (var source in selectedDetail.Sources.Take(6))
                                    {
                                        <p>@source.Metric：@source.Provider / @source.Model · @source.QualityStatus</p>
                                    }
                                </div>
                            }
                        </aside>
                    }
                </div>
            </section>
        }

        @if (result.RecommendationWindows.Count > 0)
        {
            <section class="recommendation-section" aria-labelledby="recommendation-title">
                <h2 id="recommendation-title">推荐时间窗</h2>
                <div class="recommendation-list">
                    @foreach (var window in result.RecommendationWindows)
                    {
                        <article class="recommendation-item">
                            <div>
                                <span>@window.Label</span>
                                <strong>@Session.FormatDisplay(window.StartUtc) - @Session.FormatDisplayTime(window.EndUtc)</strong>
                            </div>
                            <dl>
                                <div>
                                    <dt>时长</dt>
                                    <dd>@window.DurationHours h</dd>
                                </div>
                                <div>
                                    <dt>最佳分</dt>
                                    <dd>@window.BestScore</dd>
                                </div>
                                <div>
                                    <dt>门槛</dt>
                                    <dd>@window.MinimumScore</dd>
                                </div>
                                <div>
                                    <dt>返航</dt>
                                    <dd>@(window.ReturnBeforeUtc is null ? "暂无" : Session.FormatDisplay(window.ReturnBeforeUtc.Value))</dd>
                                </div>
                            </dl>
                            @if (window.RiskRisesAtUtc is not null)
                            {
                                <p>风险约 @Session.FormatDisplay(window.RiskRisesAtUtc.Value) 上升：@(window.RiskReason ?? "需要提前结束活动。")</p>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        <section class="tide-section" aria-labelledby="tide-title">
            <div class="section-heading tide-heading">
                <div>
                    <h2 id="tide-title">潮汐参考</h2>
                    <p>结合涨退潮节奏与海况窗口，辅助安排海钓出发、转场和收竿时间。</p>
                </div>
                <span class="tide-status status-@result.Tide.Status">@result.Tide.StatusText</span>
            </div>

            @if (result.Tide.Points.Count > 0)
            {
                <div class="tide-overview" aria-label="潮汐摘要">
                    <article>
                        <span>当前潮位</span>
                        <strong>@result.Tide.CurrentHeightM?.ToString("0.00") <small>m</small></strong>
                        <em>@(result.Tide.CurrentTrendText ?? "趋势待确认")</em>
                    </article>
                    <article>
                        <span>潮位范围</span>
                        <strong>@result.Tide.MinimumHeightM?.ToString("0.00")–@result.Tide.MaximumHeightM?.ToString("0.00") <small>m</small></strong>
                        <em>@result.Hours 小时预报范围</em>
                    </article>
                    <article>
                        <span>最近高潮</span>
                        <strong>@(result.Tide.NextHigh is null ? "暂无" : $"{result.Tide.NextHigh.HeightM:0.00} m")</strong>
                        <em>@(result.Tide.NextHigh is null ? "当前范围未标记" : Session.FormatDisplay(result.Tide.NextHigh.ForecastTimeUtc))</em>
                    </article>
                    <article>
                        <span>最近低潮</span>
                        <strong>@(result.Tide.NextLow is null ? "暂无" : $"{result.Tide.NextLow.HeightM:0.00} m")</strong>
                        <em>@(result.Tide.NextLow is null ? "当前范围未标记" : Session.FormatDisplay(result.Tide.NextLow.ForecastTimeUtc))</em>
                    </article>
                </div>

                <div class="tide-chart-shell">
                    <div id="dashboard-tide-chart"
                         class="tide-chart"
                         role="img"
                         aria-label="@($"{result.DisplayName}未来{result.Hours}小时潮位变化曲线")"></div>
                    @if (_tideChartUnavailable)
                    {
                        <p class="tide-chart-fallback" role="status">潮汐图表暂时无法加载，可继续参考上方高低潮摘要。</p>
                    }
                </div>
            }

            <p class="tide-guidance @(result.Tide.Points.Count == 0 ? "unavailable" : null)" role="status">
                @result.Tide.Message
            </p>
        </section>

        @if (result.MissingMetrics.Count > 0 || result.MissingDomains.Count > 0 || result.Flags.Count > 0)
        {
            <section class="status-band warning" role="status">
                <strong>数据状态</strong>
                <span>缺失指标：@FormatList(result.MissingMetrics)；缺失来源：@FormatList(result.MissingDomains)；标记：@FormatList(result.Flags)</span>
            </section>
        }

        <section class="source-section" aria-labelledby="source-title">
            <h2 id="source-title">数据来源</h2>
            <div class="source-list">
                @foreach (var source in result.Sources)
                {
                    <article class="source-item">
                        <div>
                            <strong>@source.DataDomain</strong>
                            <span>@source.Provider / @source.Model</span>
                        </div>
                        <dl>
                            <div>
                                <dt>发布</dt>
                                <dd>@Session.FormatDisplay(source.IssuedAtUtc)</dd>
                            </div>
                            <div>
                                <dt>抓取</dt>
                                <dd>@Session.FormatDisplay(source.FetchedAtUtc)</dd>
                            </div>
                            <div>
                                <dt>缓存</dt>
                                <dd>@source.CacheStatus</dd>
                            </div>
                            <div>
                                <dt>质量</dt>
                                <dd>@source.QualityStatus / @source.Freshness</dd>
                            </div>
                        </dl>
                    </article>
                }
            </div>
        </section>

        <section class="metric-section" aria-labelledby="metric-title">
            <h2 id="metric-title">关键指标</h2>
            <div class="metric-grid">
                @foreach (var metric in result.MetricCards)
                {
                    <article class="metric-item">
                        <span class="metric-label">@metric.Label</span>
                        <strong>@metric.Value <small>@metric.Unit</small></strong>
                        <span>@metric.Detail</span>
                        <em>@metric.StatusText</em>
                    </article>
                }
            </div>
        </section>

        <section class="hourly-section" aria-labelledby="hourly-title">
            <h2 id="hourly-title">逐小时指标</h2>
            <div class="hourly-table-wrap" tabindex="0">
                <table>
                    <thead>
                        <tr>
                            <th>时间</th>
                            <th>风速 m/s</th>
                            <th class="hide-sm">阵风 m/s</th>
                            <th>浪高 m</th>
                            <th class="hide-sm">涌浪 m</th>
                            <th class="hide-sm">能见度 km</th>
                            <th>综合分</th>
                            <th>等级</th>
                            <th class="hide-sm">质量</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in result.HourlyRows)
                        {
                            <tr class="@(Session.SelectedHourlyDetail?.ForecastTimeUtc == row.ForecastTimeUtc ? "selected-row" : null)">
                                <td>
                                    <button type="button" class="hour-link" @onclick="() => Session.SelectHour(row.ForecastTimeUtc)">
                                        @Session.FormatDisplay(row.ForecastTimeUtc)
                                    </button>
                                </td>
                                <td>@row.WindSpeedMs</td>
                                <td class="hide-sm">@row.WindGustMs</td>
                                <td>@row.WaveHeightM</td>
                                <td class="hide-sm">@row.SwellHeightM</td>
                                <td class="hide-sm">@row.VisibilityKm</td>
                                <td>@row.Score</td>
                                <td>@row.RiskLevel</td>
                                <td class="hide-sm">@row.QualityStatus</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <footer class="dashboard-footer">
        <p>
            天气与海况数据 © <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo.com</a>（<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>）；潮汐数据由 <a href="https://www.worldtides.info/" target="_blank" rel="noopener noreferrer">WorldTides</a> 提供。
        </p>
    </footer>
</main>

@code {
    private static readonly int[] HourOptions = [24, 72, 168];
    private IJSObjectReference? _mapModule;
    private IJSObjectReference? _tideChartModule;
    private DotNetObjectReference<Dashboard>? _mapCallback;
    private bool _mapInitialized;
    private bool _mapInitializationAttempted;
    private Guid? _renderedTideSnapshotId;
    private bool _tideChartUnavailable;
    private Guid? _userId;
    private string? _workspaceStatus;
    private List<FavoriteLocation> _favorites = [];

    [Parameter]
    [SupplyParameterFromQuery(Name = "locationId")]
    public Guid? LocationId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "hours")]
    public int? QueryHours { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "from")]
    public string? QueryFromUtc { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "activity")]
    public string? QueryActivity { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "lat")]
    public double? QueryLatitude { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "lon")]
    public double? QueryLongitude { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? QueryName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            _userId = UserWorkspaceEndpointExtensions.GetUserId(state.User);
            Session.ApplySettings(await Workspace.GetSettingsAsync(_userId.Value));
            _favorites = [.. await Workspace.ListFavoritesAsync(_userId.Value)];
        }

        if (QueryHours is 24 or 72 or 168)
        {
            Session.Hours = QueryHours.Value;
        }

        Session.ApplyQueryContext(ParseQueryFromUtc(QueryFromUtc), ParseQueryActivity(QueryActivity));

        if (LocationId.HasValue)
        {
            await Session.SelectCatalogLocationAsync(LocationId.Value);
        }
        else if (QueryLatitude.HasValue && QueryLongitude.HasValue)
        {
            Session.SelectMapPoint(QueryLatitude.Value, QueryLongitude.Value);
            Session.MapPointName = QueryName ?? string.Empty;
        }
        else
        {
            // 未携带地点参数时，预选首页默认地点（若已配置），地图默认收起。
            await Session.SelectHomeDefaultAsync();
        }
    }

    private async Task SearchLocationsAsync()
    {
        await Session.SearchLocationsAsync();
        if (Session.IsMapPickerOpen)
        {
            await EnsureMapAsync();
            await UpdateMapSelectionAsync();
        }
    }

    private async Task SelectLocationAsync(Guid locationId)
    {
        Session.SelectLocation(locationId);
        if (!Session.IsMapPickerOpen)
        {
            Session.ToggleMapPicker();
        }

        await EnsureMapAsync();
        await UpdateMapSelectionAsync();
    }

    private Task OnForecastDateChanged(DateTimeChangedEventArgs<DateTime?> e)
    {
        if (e.Date is { } parsed)
        {
            Session.ForecastStartLocal = new DateTime(
                parsed.Year,
                parsed.Month,
                parsed.Day,
                Session.ForecastStartLocal.Hour,
                0,
                0,
                DateTimeKind.Unspecified);
        }

        return Task.CompletedTask;
    }

    private void OnForecastTimeChanged(DateTimeChangedEventArgs<TimeOnly?> e)
    {
        if (e.Date is { } time)
        {
            var current = Session.ForecastStartLocal;
            Session.ForecastStartLocal = new DateTime(
                current.Year,
                current.Month,
                current.Day,
                time.Hour,
                0,
                0,
                DateTimeKind.Unspecified);
        }
    }

    private async Task SubmitAsync()
    {
        await Session.SubmitAnalysisAsync(_userId);
        if (_userId.HasValue && Session.Result is { } result)
        {
            await Workspace.RecordHistoryAsync(_userId.Value, new RecordQueryHistoryCommand(
                Session.SelectedLocation?.Id,
                result.DisplayName,
                result.Latitude,
                result.Longitude,
                result.FromUtc,
                result.Hours,
                Session.RequestedActivities,
                result.SnapshotId,
                result.Overall?.RiskLevel ?? "unknown",
                double.TryParse(result.Overall?.Score, out var score) ? score : null));
        }
    }

    private bool HasSelection => Session.SelectedLocation is not null || Session.SelectedMapPoint is not null;

    private string SelectedDisplayName => Session.SelectedLocation is { } location
        ? location.DisplayName
        : string.IsNullOrWhiteSpace(Session.MapPointName) ? "自定义坐标" : Session.MapPointName.Trim();

    private string SelectedCoordinate => Session.SelectedLocation is { } location
        ? $"{location.Latitude.ToString("0.###")} / {location.Longitude.ToString("0.###")}"
        : Session.SelectedMapPoint is { } point
            ? $"{point.Latitude.ToString("0.###")} / {point.Longitude.ToString("0.###")}"
            : string.Empty;

    private bool _isFavorited => Session.SelectedLocation is { } location
        ? _favorites.Any(favorite => favorite.LocationId == location.Id)
        : Session.SelectedMapPoint is { } point
            ? _favorites.Any(favorite => favorite.LocationId is null &&
                favorite.Latitude == point.Latitude && favorite.Longitude == point.Longitude)
            : false;

    private async Task ToggleFavoriteAsync()
    {
        if (!_userId.HasValue)
        {
            return;
        }

        var catalogLocationId = Session.SelectedLocation?.Id;
        var mapPoint = Session.SelectedLocation is null ? Session.SelectedMapPoint : null;

        var existing = catalogLocationId.HasValue
            ? _favorites.FirstOrDefault(favorite => favorite.LocationId == catalogLocationId)
            : mapPoint is null
                ? null
                : _favorites.FirstOrDefault(favorite =>
                    favorite.LocationId is null &&
                    favorite.Latitude == mapPoint.Latitude &&
                    favorite.Longitude == mapPoint.Longitude);

        try
        {
            if (existing is not null)
            {
                await Workspace.DeleteFavoriteAsync(_userId.Value, existing.Id);
                _favorites.RemoveAll(favorite => favorite.Id == existing.Id);
                _workspaceStatus = "已取消收藏。";
            }
            else if (catalogLocationId.HasValue)
            {
                var added = await Workspace.AddFavoriteAsync(_userId.Value, new SaveFavoriteCommand(
                    catalogLocationId,
                    null,
                    0,
                    0,
                    Session.SelectedActivity,
                    null,
                    0));
                _favorites.Add(added);
                _workspaceStatus = "已收藏。";
            }
            else if (mapPoint is not null)
            {
                var added = await Workspace.AddFavoriteAsync(_userId.Value, new SaveFavoriteCommand(
                    null,
                    string.IsNullOrWhiteSpace(Session.MapPointName) ? "自定义坐标" : Session.MapPointName.Trim(),
                    mapPoint.Latitude,
                    mapPoint.Longitude,
                    Session.SelectedActivity,
                    null,
                    0));
                _favorites.Add(added);
                _workspaceStatus = "已收藏。";
            }
        }
        catch (FavoriteAlreadyExistsException)
        {
            _workspaceStatus = "该地点已经在收藏中。";
        }
    }

    private static ActivityType? ParseQueryActivity(string? value) =>
        Enum.TryParse<ActivityType>(value, true, out var activity) ? activity : null;

    private static DateTimeOffset? ParseQueryFromUtc(string? value) =>
        DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed)
            ? parsed.ToUniversalTime()
            : null;

    private static CultureInfo ChineseCulture { get; } = CultureInfo.GetCultureInfo("zh-CN");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DetectClientTimeZoneAsync();
        }

        if ((firstRender || Session.IsMapPickerOpen) && Session.IsMapPickerOpen)
        {
            await EnsureMapAsync();
        }

        await EnsureTideChartAsync();
    }

    private async Task EnsureTideChartAsync()
    {
        if (Session.Result is not { Tide.Points.Count: > 0 } result)
        {
            if (_renderedTideSnapshotId.HasValue && _tideChartModule is not null)
            {
                await _tideChartModule.InvokeVoidAsync("dispose", "dashboard-tide-chart");
            }

            _renderedTideSnapshotId = null;
            _tideChartUnavailable = false;
            return;
        }

        if (_renderedTideSnapshotId == result.SnapshotId)
        {
            return;
        }

        _renderedTideSnapshotId = result.SnapshotId;
        try
        {
            _tideChartModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/tide-chart.js");
            var rendered = await _tideChartModule.InvokeAsync<bool>(
                "render",
                "dashboard-tide-chart",
                new
                {
                    accessibleDescription = $"{result.DisplayName}未来{result.Hours}小时潮位曲线，最低{result.Tide.MinimumHeightM:0.00}米，最高{result.Tide.MaximumHeightM:0.00}米。",
                    points = result.Tide.Points.Select(point => new
                    {
                        label = Session.FormatDisplay(point.ForecastTimeUtc),
                        fullLabel = Session.FormatDisplay(point.ForecastTimeUtc),
                        height = point.HeightM,
                        type = point.Type,
                        trendText = point.TrendText
                    })
                });
            _tideChartUnavailable = !rendered;
        }
        catch (JSException)
        {
            _tideChartUnavailable = true;
        }
        catch (InvalidOperationException)
        {
            _tideChartUnavailable = true;
        }

        if (_tideChartUnavailable)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DetectClientTimeZoneAsync()
    {
        try
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/browser-timezone.js");
            var id = await module.InvokeAsync<string>("detect");
            await module.DisposeAsync();

            if (Session.SetClientTimeZone(string.IsNullOrWhiteSpace(id) ? null : id))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task ToggleMapPickerAsync()
    {
        Session.ToggleMapPicker();
        if (!Session.IsMapPickerOpen)
        {
            await DisposeMapAsync();
        }
    }

    private async Task UseManualCoordinatesAsync()
    {
        if (Session.UseManualCoordinates())
        {
            await UpdateMapSelectionAsync();
        }
    }

    private async Task EnsureMapAsync()
    {
        if (_mapInitialized || _mapInitializationAttempted)
        {
            return;
        }

        _mapInitializationAttempted = true;
        try
        {
            _mapModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/dashboard-map.js");
            _mapCallback ??= DotNetObjectReference.Create(this);
            _mapInitialized = await _mapModule.InvokeAsync<bool>(
                "init",
                "dashboard-map-picker",
                _mapCallback,
                new
                {
                    latitude = Session.MapLatitude,
                    longitude = Session.MapLongitude,
                    zoom = 9,
                    tk = Configuration["Map:Tianditu:Key"] ?? ""
                });

            if (!_mapInitialized)
            {
                Session.MarkMapUnavailable();
            }
        }
        catch (JSException)
        {
            Session.MarkMapUnavailable("地图脚本加载失败，请直接输入经纬度继续查询。");
        }
        catch (InvalidOperationException)
        {
            Session.MarkMapUnavailable("地图交互暂时不可用，请直接输入经纬度继续查询。");
        }
    }

    private async Task UpdateMapSelectionAsync()
    {
        if (_mapModule is null || !_mapInitialized)
        {
            return;
        }

        await _mapModule.InvokeVoidAsync(
            "updateSelection",
            "dashboard-map-picker",
            Session.MapLatitude,
            Session.MapLongitude,
            10);
    }

    [JSInvokable]
    public async Task SelectMapPointFromJs(double latitude, double longitude)
    {
        Session.SelectMapPoint(latitude, longitude);
        StateHasChanged();

        if (Session.SelectedMapPoint is not { } point)
        {
            return;
        }

        string? name;
        try
        {
            name = await ReverseGeocode.FindNearestNameAsync(new GeoPoint(point.Latitude, point.Longitude));
        }
        catch
        {
            // 反查失败保持空名称，不打断地图选点主流程。
            return;
        }

        // 反查返回后确认用户没有再次选点，避免旧请求覆盖新选点的名称。
        if (name is { Length: > 0 } && Session.SelectedMapPoint == point)
        {
            Session.MapPointName = name;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task HandleMapUnavailableFromJs(string? message)
    {
        Session.MarkMapUnavailable(message);
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task HandleLocateUnavailableFromJs(string? message)
    {
        Session.SetMapError(message ?? "定位失败，请直接输入经纬度。");
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async ValueTask DisposeMapAsync()
    {
        if (_mapModule is not null)
        {
            try
            {
                await _mapModule.InvokeVoidAsync("dispose", "dashboard-map-picker");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _mapInitialized = false;
        _mapInitializationAttempted = false;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeMapAsync();
        if (_tideChartModule is not null)
        {
            try
            {
                await _tideChartModule.InvokeVoidAsync("dispose", "dashboard-tide-chart");
            }
            catch (JSDisconnectedException)
            {
            }

            await _tideChartModule.DisposeAsync();
        }

        if (_mapModule is not null)
        {
            await _mapModule.DisposeAsync();
        }

        _mapCallback?.Dispose();
    }

    private static string FormatList(IReadOnlyList<string> values) =>
        values.Count == 0 ? "无" : string.Join("、", values);
}
