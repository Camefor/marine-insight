@page "/admin/providers/worldtides"
@attribute [Authorize(Policy = "Administrator")]
@rendermode InteractiveServer
@using MarineInsight.Application.Credentials
@using MarineInsight.Infrastructure.Providers.WorldTides
@inject ProviderCredentialService CredentialService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WorldTidesProvider WorldTides
@inject IJSRuntime Js

<PageTitle>潮汐密钥 | Marine AI</PageTitle>

<main class="workspace-page admin-page">
    <header class="workspace-heading">
        <div><p class="workspace-eyebrow">管理员</p><h1>WorldTides 密钥</h1></div>
    </header>

    <AdminTabs />

    <section class="admin-section" aria-labelledby="credential-form-title">
        <h2 id="credential-form-title">添加新 Key</h2>
        <form class="workspace-form" @onsubmit="AddAsync" @onsubmit:preventDefault>
            <label>
                <span>API Key</span>
                <input type="password" @bind="_newApiKey" maxlength="256" autocomplete="off" placeholder="粘贴新的 WorldTides API Key" />
            </label>
            <p class="map-hint">密钥以 DataProtection 加密后存入数据库，仓库与项目目录内不出现明文。启用 Key 失效时，请求会自动尝试备用 Key。</p>
            <div class="workspace-form-actions">
                <button class="workspace-secondary" type="button" @onclick="TestAsync" disabled="@_testing">@(_testing ? "测试中…" : "测试连接")</button>
                <button class="workspace-primary" type="submit" disabled="@_testing">添加</button>
            </div>
        </form>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="@(_messageIsError ? "account-alert" : "workspace-status")" role="status">@_message</p>
        }
    </section>

    @if (_loading)
    {
        <p class="workspace-status" role="status">正在加载密钥…</p>
    }
    else if (_credentials.Count == 0)
    {
        <section class="workspace-empty">
            <h2>暂无密钥</h2>
            <p>添加密钥后用于 WorldTides 潮汐查询；第一个添加的 Key 自动启用。</p>
        </section>
    }
    else
    {
        <section class="admin-section" aria-labelledby="credentials-title">
            <h2 id="credentials-title">密钥列表（@_credentials.Count）</h2>
            <div class="admin-table-wrap">
                <table>
                    <thead><tr><th>密钥</th><th>状态</th><th>剩余 Credits</th><th>最近检查</th><th>失败原因</th><th>操作</th></tr></thead>
                    <tbody>
                        @foreach (var credential in _credentials)
                        {
                            <tr @key="credential.Id">
                                <td>@credential.KeyHint @(credential.IsActive ? "（启用）" : string.Empty)</td>
                                <td>@HealthText(credential.Health)</td>
                                <td>@CreditsText(credential)</td>
                                <td>@(credential.LastCheckedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@(credential.LastFailureReason ?? "—")</td>
                                <td>
                                    @if (!credential.IsActive)
                                    {
                                        <button class="workspace-icon-button" type="button" title="设为启用" aria-label="设为启用 @credential.KeyHint" @onclick="() => ActivateAsync(credential.Id)"><UiIcon Name="Check" /></button>
                                    }
                                    <button class="workspace-icon-button danger" type="button" title="删除" aria-label="删除 @credential.KeyHint" @onclick="() => DeleteAsync(credential.Id, credential.KeyHint)"><UiIcon Name="Trash2" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>

@code {
    private Guid _userId;
    private bool _loading = true;
    private bool _testing;
    private string _newApiKey = string.Empty;
    private string? _message;
    private bool _messageIsError;
    private IReadOnlyList<ProviderCredentialSummary> _credentials = [];

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _credentials = await CredentialService.ListAsync("worldtides");
        _loading = false;
    }

    private async Task<Guid> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return UserWorkspaceEndpointExtensions.GetUserId(state.User);
    }

    private async Task TestAsync()
    {
        _message = null;
        if (string.IsNullOrWhiteSpace(_newApiKey))
        {
            _message = "请先输入 API Key。";
            _messageIsError = true;
            return;
        }

        _testing = true;
        var result = await WorldTides.ValidateKeyAsync(_newApiKey, default);
        _testing = false;
        _message = result.Message;
        _messageIsError = !result.Success;
    }

    private async Task AddAsync()
    {
        _message = null;
        try
        {
            await CredentialService.AddAsync(_userId, "worldtides", _newApiKey);
            _newApiKey = string.Empty;
            _message = "已添加，第一个添加的 Key 自动启用。";
            _messageIsError = false;
            await ReloadAsync();
        }
        catch (ProviderCredentialConflictException exception)
        {
            _message = exception.Message;
            _messageIsError = true;
        }
        catch (ArgumentException exception)
        {
            _message = exception.Message;
            _messageIsError = true;
        }
    }

    private async Task ActivateAsync(Guid id)
    {
        _message = null;
        try
        {
            await CredentialService.SetActiveAsync(_userId, "worldtides", id);
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            _message = exception.Message;
            _messageIsError = true;
        }
    }

    private async Task DeleteAsync(Guid id, string keyHint)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"确定删除密钥 {keyHint} 吗？"))
        {
            return;
        }

        _message = null;
        try
        {
            await CredentialService.DeleteAsync(_userId, "worldtides", id);
            await ReloadAsync();
        }
        catch (ProviderCredentialInUseException exception)
        {
            _message = exception.Message;
            _messageIsError = true;
        }
        catch (ArgumentException exception)
        {
            _message = exception.Message;
            _messageIsError = true;
        }
    }

    private static string HealthText(ProviderCredentialHealth health) => health switch
    {
        ProviderCredentialHealth.Healthy => "正常",
        ProviderCredentialHealth.Failed => "失败",
        _ => "未测试"
    };

    private static string CreditsText(ProviderCredentialSummary credential) =>
        credential.RemainingCredits is { } credits
            ? credential.CreditWarning ? $"{credits}（偏低）" : credits.ToString()
            : "—";
}
