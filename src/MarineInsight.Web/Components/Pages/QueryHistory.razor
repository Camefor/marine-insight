@page "/query-history"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserWorkspaceService Workspace
@inject IJSRuntime Js

<PageTitle>查询历史 | Marine AI</PageTitle>

<main class="workspace-page">
    <header class="workspace-heading">
        <div><p class="workspace-eyebrow">个人工作区</p><h1>查询历史</h1></div>
        @if (!_loading && _history.Count > 0)
        {
            <button class="workspace-danger" type="button" @onclick="ClearAsync">清空全部</button>
        }
    </header>
    @if (_loading)
    {
        <p class="workspace-status" role="status">正在加载查询历史…</p>
    }
    else if (_history.Count == 0)
    {
        <section class="workspace-empty"><h2>暂无查询记录</h2><p>登录后完成的海况查询会保留最近记录。</p></section>
    }
    else
    {
        <div class="workspace-list">
            @foreach (var item in _history)
            {
                <article class="workspace-row" @key="item.Id">
                    <div class="workspace-row-main">
                        <h2>@item.DisplayName</h2>
                        <p>@item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @item.Hours 小时</p>
                    </div>
                    <dl class="workspace-meta">
                        <div><dt>风险</dt><dd>@item.RiskLevel</dd></div>
                        <div><dt>评分</dt><dd>@(item.Score?.ToString("0") ?? "暂无")</dd></div>
                    </dl>
                    <div class="workspace-actions">
                        @if (item.LocationId.HasValue)
                        {
                            <a class="workspace-icon-button" title="按原条件再次查询" aria-label="再次查询 @item.DisplayName" href="@BuildQueryUrl(item)"><UiIcon Name="RotateCcw" /></a>
                        }
                        <button class="workspace-icon-button danger" type="button" title="删除记录" aria-label="删除记录 @item.DisplayName" @onclick="() => DeleteAsync(item.Id)"><UiIcon Name="Trash2" /></button>
                    </div>
                </article>
            }
        </div>
    }
</main>

@code {
    private Guid _userId;
    private bool _loading = true;
    private IReadOnlyList<QueryHistoryItem> _history = [];

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _history = await Workspace.ListHistoryAsync(_userId);
        _loading = false;
    }

    private async Task<Guid> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return UserWorkspaceEndpointExtensions.GetUserId(state.User);
    }

    private async Task DeleteAsync(Guid historyId)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "确定删除这条查询记录吗？"))
        {
            return;
        }

        await Workspace.DeleteHistoryAsync(_userId, historyId);
        await ReloadAsync();
    }

    private async Task ClearAsync()
    {
        if (!await Js.InvokeAsync<bool>("confirm", "确定清空全部查询历史吗？此操作不可撤销。"))
        {
            return;
        }

        await Workspace.ClearHistoryAsync(_userId);
        await ReloadAsync();
    }

    private static string BuildQueryUrl(QueryHistoryItem item)
    {
        var activity = item.Activities.FirstOrDefault();
        return $"/?locationId={item.LocationId}&hours={item.Hours}&from={Uri.EscapeDataString(item.ForecastFromUtc.ToString("O"))}&activity={activity}";
    }
}
