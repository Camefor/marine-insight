@inherits LayoutComponentBase

<header class="app-header">
    <div class="app-header-brand">
        <a class="app-brand" href="/" aria-label="Marine AI 首页">
            <img class="app-brand-logo"
                 src="/images/brand/marine-ai-logo.svg"
                 width="202"
                 height="44"
                 alt="" />
        </a>
        <nav class="main-nav" aria-label="主导航">
            <a class="account-link" href="/">海况查询</a>
            <a class="account-link" href="/about">功能介绍</a>
        </nav>
    </div>
    <div class="app-header-actions">
        <AccountNav />
    </div>
</header>

<nav class="mobile-dock" aria-label="移动端主导航">
    <a href="/" class="mobile-dock-link is-active"><UiIcon Name="House" /><small>海况</small></a>
    <a href="/#query-title" class="mobile-dock-link"><UiIcon Name="MapPin" /><small>地图</small></a>
    <a href="/favorites" class="mobile-dock-link"><UiIcon Name="Star" /><small>收藏</small></a>
    <a href="/settings" class="mobile-dock-link"><UiIcon Name="Settings" /><small>设置</small></a>
</nav>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><UiIcon Name="X" /></span>
</div>
