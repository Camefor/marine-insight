{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "OpenTelemetry": {
        "Endpoint": ""
    },
    "Identity": {
        "RequireConfirmedEmail": false
    },
    "TideProviders": {
        "WorldTides": {
            "Enabled": false,
            "BaseUrl": "https://www.worldtides.info/api/v3",
            "Timeout": "00:00:15",
            "CacheLifetime": "12:00:00",
            "CreditWarningThreshold": 100
        }
    },
    "Caching": {
        "Forecast": {
            "Environment": "development",
            "NormalizerVersion": "v1",
            "CoordinatePrecision": 4,
            "FreshLifetime": "00:15:00",
            "StaleIfErrorLifetime": "02:00:00"
        }
    },
    "ForecastProviders": {
        "OpenMeteo": {
            "Enabled": true,
            "WeatherBaseUrl": "https://api.open-meteo.com/v1/forecast",
            "MarineBaseUrl": "https://marine-api.open-meteo.com/v1/marine",
            "WeatherModel": "best_match",
            "MarineModel": "best_match",
            "Timeout": "00:00:15"
        }
    },
    "AllowedHosts": "*"
}
