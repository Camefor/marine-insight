{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Endpoint": ""
  },
  "ForecastProviders": {
    "OpenMeteo": {
      "Enabled": true,
      "WeatherBaseUrl": "https://api.open-meteo.com/v1/forecast",
      "MarineBaseUrl": "https://marine-api.open-meteo.com/v1/marine",
      "WeatherModel": "best_match",
      "MarineModel": "best_match",
      "Timeout": "00:00:15"
    }
  },
  "AllowedHosts": "*"
}
